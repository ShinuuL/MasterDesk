{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MasterNote",
  "version": "0.2.0",
  "identifier": "com.masterdesk.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix ../frontend",
    "beforeBuildCommand": "npm run build --prefix ../frontend",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MasterNote",
        "width": 1080,
        "height": 620,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ShinuuL/MasterDesk/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlFMURGMzhGNDc5OTUxQzcKUldUSFVabEhqL01kbnJ0cHJ1ZS9oQnJydTQ1STBEUWYrVlk0bEhtbm9JN2N2NHhNTW93S29YaVUK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
