{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MasterDesk",
  "version": "0.1.0",
  "identifier": "com.masterdesk.app",
  "build": {
    "beforeDevCommand": "npm run dev --prefix frontend",
    "beforeBuildCommand": "npm run build --prefix frontend",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "MasterDesk",
        "width": 1080,
        "height": 620,
        "minWidth": 800,
        "minHeight": 500,
        "resizable": true,
        "center": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
